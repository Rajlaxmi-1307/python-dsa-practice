   "source": [
    "# Import NumPy\n",
    "import numpy as np\n",
    "\n",
    "# Create an array\n",
    "arr = np.array([50, 20, 40, 10, 30])\n",
    "\n",
    "# Print original array\n",
    "print(\"Original Array:\", arr)\n",
    "\n",
    "# Sort the array in ascending order\n",
    "sorted_arr = np.sort(arr)\n",
    "\n",
    "print(\"Sorted Array:\", sorted_arr)"
   ]
  }
 ],
